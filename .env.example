# TakeYourToken.app - Environment Variables Template
# Copy this file to .env and fill in your actual values
# NEVER commit the .env file to GitHub!

# ==============================================================================
# SUPABASE (REQUIRED)
# ==============================================================================
# Get these from: https://supabase.com/dashboard/project/_/settings/api
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key_here

# ==============================================================================
# EMAIL SERVICE (OPTIONAL)
# ==============================================================================
# For contact form notifications
# Provider: Resend (https://resend.com)
# Get API key from: https://resend.com/api-keys
RESEND_API_KEY=re_your_api_key_here

# ==============================================================================
# TELEGRAM NOTIFICATIONS (OPTIONAL)
# ==============================================================================
# For admin notifications via Telegram
# Setup guide: docs/private/TELEGRAM_BOT_SETUP.md
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz
TELEGRAM_ADMIN_CHAT_ID=123456789

# ==============================================================================
# NOTES
# ==============================================================================
# - .env file is gitignored for security
# - Never share your .env file
# - Use different values for development and production
# - Test with example values first before using real credentials
# - See docs/private/ for detailed setup instructions
